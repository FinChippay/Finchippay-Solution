# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Next.js ─────────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
*.tsbuildinfo

# ─── Backend ─────────────────────────────────────────────────────────────────
backend/.env
backend/logs/

# ─── Rust / Cargo ─────────────────────────────────────────────────────────────
target/
# Written to the repository root by the gas_profile test.
gas-report.json

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Editor ───────────────────────────────────────────────────────────────────
# Ignore personal editor settings but track shared team config
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.user

# ─── Terraform ────────────────────────────────────────────────────────────────
# State files — may contain secrets; never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# tfvars may contain secrets
terraform.tfvars
*.auto.tfvars

# Local Terraform working directories
.terraform/
.terraform.lock.hcl

# Crash log output
crash.log
crash.*.log

# Terraform plan files (can contain sensitive data)
*.tfplan

# ─── SBOM output ───────────────────────────────────────────────────────────────
# Generated by `make sbom` (syft). Regenerable; never committed.
sbom/

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.log
.env
dist/
build/
# Playwright
playwright-report/
test-results/
test_snapshots

# ─── Contract bindings ─────────────────────────────────────────────────────────
# frontend/lib/contract-bindings/ is auto-generated by scripts/gen-contract-bindings.sh
# and is checked into version control. CI enforces drift detection.

# ─── Local scripts (never push) ───────────────────────────────────────────────
scripts/create_issues.py

# Webhook SQLite database (runtime artifact, never commit)
backend/data/
