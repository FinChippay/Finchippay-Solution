FROM node:22.23.2-alpine

# Patch OS packages to the latest Alpine 3.24 security releases. The base
# image tag pins a snapshot whose openssl, util-linux and libexpat packages
# carry CRITICAL/HIGH CVEs, which would otherwise fail the Trivy gate in the
# Kubernetes deploy pipeline.
RUN apk upgrade --no-cache

WORKDIR /app

# Install production dependencies only.
COPY --chown=node:node backend/package*.json ./
RUN npm install --omit=dev && npm cache clean --force

# npm exists only to install dependencies — the container runs
# `node src/server.js` directly. Drop npm and npx along with npm's bundled
# dependency tree (tar, pacote, sigstore, …), whose CRITICAL/HIGH CVEs would
# otherwise fail the Trivy gate in the deploy pipeline.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# Copy source code and shared module
COPY --chown=node:node backend/ .
COPY --chown=node:node shared/ ./shared/

# Runtime-writable directories, owned by the non-root "node" user.
# Mounted as named volumes in docker-compose.prod.yml (data: SQLite DB +
# cached token metadata, backups: DB backup archives, .ipfs-cache: IPFS
# metadata cache) so they persist across restarts even with read_only: true
# on the container's root filesystem.
RUN mkdir -p backups .ipfs-cache && chown node:node backups .ipfs-cache

# Run as the non-root "node" user (built into the base image) rather than
# root, per production hardening requirements.
USER node

# Expose port 4000
EXPOSE 4000

CMD ["node", "src/server.js"]
