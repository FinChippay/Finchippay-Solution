FROM node:22-alpine

WORKDIR /app

# Create non-root user and app directories
RUN addgroup -g 1001 -S nodejs && \
    adduser -S node -u 1001 && \
    mkdir -p /app/logs && \
    chown -R node:nodejs /app

# Install dependencies
COPY --chown=node:nodejs backend/package*.json ./
RUN npm install --production && \
    npm cache clean --force

# Copy source code and shared module
COPY --chown=node:nodejs backend/ .
COPY --chown=node:nodejs shared/ ./shared/

# Expose port 4000
EXPOSE 4000

# Run as non-root user
USER node

CMD ["node", "src/server.js"]