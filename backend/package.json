{
  "name": "finchippay-backend",
  "version": "1.0.0",
  "description": "Backend API for Finchippay Solution",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:turrets": "TURRETS_PORT=4100 nodemon src/server.js",
    "start": "node src/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --forceExit --testPathIgnorePatterns='/(integration|federation)\\.test\\.'",
    "test:integration": "jest --forceExit --testPathPatterns='integration|federation'",
    "lint": "eslint 'src/**/*.js'",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "node src/db/migrate-status.js",
    "seed": "knex seed:run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@sentry/node": "^10.69.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "graphql": "^16.14.2",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-tag": "^2.12.7",
    "handlebars": "^4.7.10",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pino": "^9.0.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "4.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "fast-check": "^3.22.0",
    "jest": "^30.5.2",
    "js-yaml": "^4.1.0",
    "nock": "^14.0.15",
    "nodemon": "^3.1.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "qs": "6.16.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
