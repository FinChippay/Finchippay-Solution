{
  "name": "finchippay-backend",
  "version": "1.0.0",
  "description": "Backend API for Finchippay Solution",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:turrets": "TURRETS_PORT=4100 nodemon src/server.js",
    "start": "node src/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='/(integration|federation)\\.test\\.'",
    "test:integration": "jest --testPathPattern='integration|federation'",
    "lint": "eslint 'src/**/*.js'",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "node src/db/migrate-status.js",
    "seed": "knex seed:run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@sentry/node": "^10.69.0",
    "@stellar/stellar-sdk": "^16.2.0",
    "axios": "^1.6.8",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "graphql": "^16.14.2",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-tag": "^2.12.7",
    "handlebars": "^4.7.9",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.7.0",
    "pg": "^8.15.0",
    "pino": "^9.0.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "4.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "fast-uri": "3.1.5",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1"
    }
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "fast-check": "^3.22.0",
    "jest": "^30.3.0",
    "js-yaml": "^4.1.0",
    "nock": "^14.0.15",
    "nodemon": "^3.1.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22.23.2"
  },
  "overrides": {
    "uuid": ">=11.1.1"
  }
}
