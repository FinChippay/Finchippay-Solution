# backend/.env.example
# Copy this file to backend/.env and fill in your values.
#
# Required variables are marked with [REQUIRED].
# All others have sensible defaults for development.

# ─── Stellar Network [REQUIRED] ────────────────────────────────────────────────
# Must be "testnet" or "mainnet"
STELLAR_NETWORK=testnet

# Stellar Horizon API base URL [REQUIRED]
HORIZON_URL=https://horizon-testnet.stellar.org

# ─── Database ────────────────────────────────────────────────────────────────
# Database provider: "sqlite" (default) or "postgres"
# SQLite uses DB_FILENAME; PostgreSQL requires DATABASE_URL.
# Config lives in backend/knexfile.js, keyed by NODE_ENV:
#   development → sqlite, DB_FILENAME default backend/data/finchippay.db
#   test        → sqlite, backend/data/test.db (provisioned fresh by Jest)
#   production  → postgres via DATABASE_URL
# Schema is managed with Knex migrations: `npm run migrate` (and migrate:rollback,
# migrate:status, seed). In development the server auto-migrates on startup.
DB_PROVIDER=sqlite
# DB_FILENAME=./data/finchippay.db
# DATABASE_URL=postgresql://user:password@localhost:5432/finchippay

# ─── Security [REQUIRED] ──────────────────────────────────────────────────────
# Secret key for SEP-0010 JWT token signing min 32 chars
# Generate: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_32_bytes_min

# Comma-separated Stellar public keys allowed to access admin endpoints.
# ADMIN_PUBLIC_KEYS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# HMAC key used to pseudonymize client IPs in rate-limit analytics.
# Generate independently from JWT_SECRET: openssl rand -hex 32
# RATE_LIMIT_IP_HASH_SALT=change-me-to-an-independent-random-secret
# RATE_LIMIT_METRICS_MAX_EVENTS=10000

# AES-256 key for encrypting webhook secrets at rest (required in production)
# Generate: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=

# Comma-separated list of CORS-allowed origins [REQUIRED for production]
# Format: scheme://host[:port] no trailing slash, no wildcards
# Defaults to http://localhost:3000 if unset
ALLOWED_ORIGINS=http://localhost:3000

# ─── Redis (rate limiting, caching) ──────────────────────────────────────────
# Redis URL for shared rate limit store across multiple backend instances.
# Falls back to in-memory store if unset (suitable for single-instance dev).
# REDIS_URL=redis://redis:6379

# ─── Server ───────────────────────────────────────────────────────────────────
# HTTP port default: 4000
PORT=4000

# Environment: "development", "test", or "production" default: development
NODE_ENV=development

# Log level: "trace", "debug", "info", "warn", "error", "fatal" default: info
LOG_LEVEL=info

# ─── Error Tracking optional ────────────────────────────────────────────────
# Sentry DSN for error monitoring. Disabled if unset.
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/1234567

# ─── Federation SEP-0002 ───────────────────────────────────────────────────
# Domain used in .well-known/stellar.toml discovery
# Falls back to DOMAIN, HOME_DOMAIN, or the request Host header
# FEDERATION_DOMAIN=stellarfinchippay.io

# Override the federation server URL defaults to https://<FEDERATION_DOMAIN>/federation
# FEDERATION_SERVER_URL=https://finchippay.io/federation

# Protocol override for federation server URL "http" or "https"
# Auto-detected from domain unless explicitly set
# FEDERATION_SERVER_PROTOCOL=https

# Home domain for SEP-0010 challenge signing default: localhost:4000
# HOME_DOMAIN=finchippay.io

# Additional federation domains comma-separated
# FEDERATION_DOMAINS=finchippay.io,stellarfinchippay.io

# ─── Turrets Scheduled Transactions ─────────────────────────────────────────
# Port for the Turrets side-server default: 4100
# TURRETS_PORT=4100

# Interval in ms between txFunction evaluation polls default: 30000
TURRETS_EVALUATION_INTERVAL_MS=30000

# Optional CoinGecko Pro API key used by the Turrets price feed.
# When unset, the public CoinGecko endpoint is used before Binance/CoinCap fallbacks.
# PRICE_FEED_COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Turrets price provider request timeout in ms default: 5000
# PRICE_FEED_TIMEOUT_MS=5000

# ─── Stellar Account SEP-0010 ───────────────────────────────────────────────
# Stellar secret key for challenge signing. Auto-generated on startup if unset.
# SERVER_PRIVATE_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── AI Payment Parsing optional ────────────────────────────────────────────
# Anthropic API key for the AI payment assistant feature.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email Notifications ───────────────────────────────────────────────────────
# Enable or disable email notifications (default: false)
NOTIFICATION_EMAIL_ENABLED=false

# SMTP configuration for sending notification emails
# For development, use a service like Mailtrap, Ethereal, or Gmail App Password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to "true" for SSL (port 465), "false" for STARTTLS (port 587)
# SMTP_SECURE=false

# SMTP authentication credentials
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password

# From address for notification emails (default: noreply@finchippay.io)
# SMTP_FROM=noreply@finchippay.io

# ─── Health Checks (backend/src/services/healthService.js) ─────────────────
# Timeout for outbound dependency probes (Horizon, Soroban RPC, Postgres, Redis)
# HEALTH_TIMEOUT_MS=5000

# Latency (ms) above which a successful dependency check is reported "degraded"
# POSTGRES_DEGRADED_LATENCY_MS=200
# REDIS_DEGRADED_LATENCY_MS=100
# HORIZON_DEGRADED_LATENCY_MS=1000
# SOROBAN_DEGRADED_LATENCY_MS=1000

# Disk usage percentage thresholds for the /api/health/dependencies disk check
# HEALTH_DISK_PATH=.
# DISK_USAGE_DEGRADED_PERCENT=80
# DISK_USAGE_UNHEALTHY_PERCENT=90

# Process RSS memory thresholds in MB
# MEMORY_RSS_DEGRADED_MB=400
# MEMORY_RSS_UNHEALTHY_MB=500

# Event loop lag thresholds in ms
# EVENT_LOOP_LAG_DEGRADED_MS=50
# EVENT_LOOP_LAG_UNHEALTHY_MS=100

# How long (ms) the readiness probe keeps failing after SIGTERM/SIGINT before
# background workers stop and the process exits — gives Kubernetes time to
# drain in-flight connections.
# SHUTDOWN_DRAIN_MS=10000
