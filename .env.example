# Finchippay Solution — Root Environment Variables
# Copy to .env and configure for your environment

# Network
STELLAR_NETWORK=testnet

# Backend
DATABASE_URL=postgres://user:password@localhost:5432/finchippay
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
ANCHORS_CONFIG={"testanchor":{"sep24Url":"https://testanchor.stellar.org/sep24","supportedAssets":["SRT","USDC"]}}

# Frontend
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Contract
NEXT_PUBLIC_CONTRACT_ID=
