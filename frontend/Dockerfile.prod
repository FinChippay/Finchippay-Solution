# Stage 1: Build stage
#
# Build context is the repository root (same as backend/Dockerfile.prod).
# The frontend depends on the SDK via "file:../sdk" and imports
# shared/errorCodes from the repo root. Those are resolvable only when the
# repository's workspace layout is preserved in the image (root package.json
# + hoisted node_modules), which is exactly how the frontend is built in CI
# and locally — Turbopack refuses to resolve them from a standalone
# frontend-only install.
FROM node:22.23.2-alpine AS builder

WORKDIR /app

# Install the whole workspace (frontend + sdk) from the root lockfile, the
# same install CI uses.
COPY package.json package-lock.json ./
COPY sdk/ ./sdk/
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci

# The SDK ships only TypeScript source (main: dist/index.js); compile it.
RUN npm run build --workspace=sdk

# Copy source code and build
COPY frontend/ ./frontend/
COPY shared/ ./shared/
ENV NEXT_OUTPUT=export

# Required at build time by the Next.js config/env validation. Defaults match
# what CI uses; override via --build-arg where needed.
ARG NEXT_PUBLIC_STELLAR_NETWORK=testnet
ARG NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ARG NEXT_PUBLIC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ52NVF3FB25GQ2G6E3BGLZ52B7W7TKG4E7SML2
ENV NEXT_PUBLIC_STELLAR_NETWORK=$NEXT_PUBLIC_STELLAR_NETWORK \
    NEXT_PUBLIC_HORIZON_URL=$NEXT_PUBLIC_HORIZON_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_CONTRACT_ID=$NEXT_PUBLIC_CONTRACT_ID
RUN cd frontend && npm run build

# Stage 2: Serve stage
#
# Uses the nginx-unprivileged image rather than the stock nginx image: the
# stock image has no non-root user capable of binding to a low port, so
# "user: node" (which the base issue spec suggested) doesn't apply here —
# this is a static-file/proxy service, not a Node.js one. nginx-unprivileged
# is purpose-built to run as a non-root user (uid 101 "nginx") and listens
# on 8080 by default instead of 80, since binding <1024 requires root.
FROM nginxinc/nginx-unprivileged:1.31.3-alpine

# Copy built static files from build stage
COPY --from=builder --chown=nginx:nginx /app/frontend/out /usr/share/nginx/html

# Copy nginx configuration (listens on 8080 — see nginx.conf)
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Already runs as the non-root "nginx" user by default in this image.

# Expose port 8080 (mapped to host port 80 in docker-compose.prod.yml)
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]