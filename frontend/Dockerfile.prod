# Stage 1: Build stage
FROM node:20.19.5-alpine AS builder

WORKDIR /app

# Create non-root user for build
RUN addgroup -g 1001 -S nodejs && \
    adduser -S node -u 1001

# Install dependencies
COPY --chown=node:nodejs package*.json ./
RUN npm ci

# Copy source code and build
COPY --chown=node:nodejs . .
RUN npm run build

# Stage 2: Serve stage
FROM nginx:alpine

# Create non-root user
RUN addgroup -g 1001 -S nginxgroup && \
    adduser -S nginxuser -u 1001 -G nginxgroup && \
    mkdir -p /var/cache/nginx /var/run && \
    chown -R nginxuser:nginxgroup /var/cache/nginx /var/run /usr/share/nginx

# Copy built static files from build stage
COPY --from=builder --chown=nginxuser:nginxgroup /app/out /usr/share/nginx/html

# Copy nginx configuration
COPY --chown=nginxuser:nginxgroup nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Run as non-root user
USER nginxuser

CMD ["nginx", "-g", "daemon off;"]