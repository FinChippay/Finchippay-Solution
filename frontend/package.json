{
  "name": "finchippay-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern '**/__tests__/**'",
    "analyze": "set ANALYZE=true && next build",
    "i18n:scan": "i18next-scanner --config i18next-scanner.config.js",
    "i18n:check": "i18next-scanner --config i18next-scanner.config.js 'pages/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' 'hooks/**/*.{ts,tsx}' 'utils/**/*.{ts,tsx}' 'stories/**/*.{ts,tsx}'",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:a11y:full": "playwright test e2e/accessibility.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@finchippay/sdk": "file:../sdk",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@heroicons/react": "^2.2.0",
    "@sentry/nextjs": "^10.76.2",
    "@stellar/freighter-api": "^3.1.0",
    "@stellar/stellar-sdk": "^16.4.1",
    "@types/papaparse": "^5.5.2",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.23.0",
    "axios": "^1.6.8",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.42.2",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "next": "^16.4.2",
    "papaparse": "^5.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.3",
    "react-is": "^18.3.1",
    "react-joyride": "2.9.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "9.1.21",
    "@storybook/addon-docs": "9.1.21",
    "@storybook/nextjs-vite": "9.1.21",
    "@storybook/react": "^9.1.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.6.1",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "9.1.21",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^3.22.0",
    "i18next-scanner": "^4.2.0",
    "jest": "^30.5.2",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "8.5.31",
    "storybook": "9.1.21",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.20.2"
  },
  "overrides": {
    "image-size": "2.0.2",
    "uuid": "14.0.1",
    "postcss": "8.5.31",
    "sharp": "0.35.4",
    "js-yaml@4": "4.3.2"
  }
}
